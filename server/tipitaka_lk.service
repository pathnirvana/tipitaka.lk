# systemd unit for the tipitaka.lk Go server (v3) - installed by scripts/deploy.sh to /etc/systemd/system/
# scripts/deploy.sh puts each release in ~/www/tipitaka.lk/releases/<ts> and points ~/www/tipitaka.lk/current at it.
# -published-version: the version old apps see at /tipitaka-query/version - change to 3.0 after the v3 apps are published
[Unit]
Description=Tipitaka.lk Go server
After=network.target

[Service]
Type=simple
User=janaka
WorkingDirectory=/home/janaka/www/tipitaka.lk/current
ExecStart=/home/janaka/www/tipitaka.lk/current/tipitaka_lk -no-open -listen 127.0.0.1:8400 -published-version 2.0
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
